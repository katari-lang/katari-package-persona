// A persona is an ordered set of layers, supplied by the caller as data. `assemble` concatenates the
// layers a role sees into one per-turn injection; `refine` overwrites one layer's body, rejected when
// it exceeds that layer's cap. A facility in the store's sense — every read and write opens `persona/`
// under the calling workspace, so where the layers land is the caller's decision. Reads are total.

@"One persona layer — the unit the caller supplies. @name@ is its store key and the identifier
`refine` targets, @label@ is the `[label]` header its assembled section wears, @cap@ is the hard
character ceiling `refine` enforces, @seed@ is the in-code default body shown until a refinement is
stored, @roles@ is the set of role names that see this layer, and @hard_lines@ is an uneditable prefix
prepended above the refinable body at every assembly."
data layer(
  @"The layer's store key AND the identifier `refine` targets, e.g. \"identity\"." name: string,
  @"The `[label]` section header the assembled layer wears — may differ from @name@." label: string,
  @"The HARD character cap `refine` enforces; the anti-creep ceiling." cap: integer,
  @"The in-code default body, shown until a refinement is stored." seed: string,
  @"The role names that SEE this layer — its per-role visibility." roles: array[string],
  @"An uneditable prefix prepended above the refinable body at every assembly; it outlives any refine. Blank for a layer with no hard lines." hard_lines: string ?= "",
)

@"The facility's one subdirectory under the calling workspace, prefixed to every persona read and
write. The package hard-codes the subdirectory name, never the full location."
agent path() -> string {
  "persona"
}

// Duplicated in `memory.render_note` on purpose: the two packages share a shape, not a decision, and
// both are leaf store facilities that saying it once would give a dependency.
@"Render one stored layer value as text: a plain string as itself, anything else as its JSON — total,
so a malformed stored value degrades rather than throwing into an every-turn assembly."
agent render_value(value: unknown) -> string {
  match (value) {
    case string(text) -> text
    case _ -> json.stringify(value = value)
  }
}

@"The live body of one layer: its stored value once a refinement exists, its in-code @seed@ until
then. The caller must already stand inside the facility workspace, which `assemble` opens once around
the whole read."
agent live_body(entry: layer) -> string {
  match (store.get(key = entry.name)) {
    case store.found(value => value) -> render_value(value = value)
    case store.absent(key => _) -> entry.seed
  }
}

@"One assembled persona section: the `[label]` header, then — when the layer carries hard lines — its
uneditable prefix and a blank line, then the layer's live body. The hard lines ride above the refinable
body, so they survive whatever a refine did to it."
agent render_layer(entry: layer) -> string {
  let body = live_body(entry = entry)
  if (string.trim(value = entry.hard_lines) == "") {
    f"[${entry.label}]\n${body}"
  } else {
    f"[${entry.label}]\n${entry.hard_lines}\n\n${body}"
  }
}

@"Assemble one role's persona note: render the `[label]` section of each layer the role sees, in the
given order, and join them with a blank line. Every layer is read fresh from the store under the
facility workspace, so a refinement is live on the very next turn and a compaction can never eat a
persona. A layer the role does not see is skipped, and a role that sees nothing assembles to \"\"."
agent assemble(layers: array[layer], role: string) -> string {
  use store.workspace(path = path())
  // The parameter is named `value` because `array.filter`'s predicate names it so, and parameter names
  // are structural.
  agent sees_role(value: layer) -> boolean {
    array.contains(target = value.roles, value = role)
  }
  let visible = array.filter(target = layers, keep = sees_role)
  let sections = for (let entry in visible) {
    next render_layer(entry = entry)
  }
  string.join(parts = sections, separator = "\n\n")
}

@"The layer named @name@ among @layers@, or null when none matches — the lookup behind `refine`'s
dispatch."
agent find_layer(layers: array[layer], name: string) -> layer | null {
  for (let entry in layers, var found: layer | null = null) {
    if (entry.name == name) {
      next with { found = entry }
    } else {
      next with { found = found }
    }
  } then (_layers) {
    found
  }
}

@"The @layers@' names, in order — the list `refine` shows when a supplied name matches no layer."
agent layer_names(layers: array[layer]) -> array[string] {
  for (let entry in layers) {
    next entry.name
  }
}

@"Refine one layer — the anti-creep write, answering the sentence a model reads. Look @name@ up among
@layers@: an unknown name answers a corrective note listing the layers (never a crash — the name is
model-supplied); a @text@ over the layer's cap is rejected with the cap and the overshoot; a text
within cap overwrites the whole layer body under the facility workspace and confirms. The hard lines
are never stored and never touched, and a whole-key overwrite is last-write-wins, so this takes no
critical section."
agent refine(layers: array[layer], name: string, text: string) -> string {
  match (find_layer(layers = layers, name = name)) {
    case null -> {
      let names = string.join(parts = layer_names(layers = layers), separator = ", ")
      f"(no persona layer is named ${name}; the layers you can refine are ${names}.)"
    }
    case entry -> {
      let measured = string.length(value = text)
      if (measured > entry.cap) {
        f"(rejected: the ${entry.name} layer is capped at ${entry.cap} characters and this text is ${measured}. Compress it — cut examples before rules, merge overlapping lines — and try again. The cap is the anti-creep mechanism; it does not move.)"
      } else {
        use store.workspace(path = path())
        store.set(key = entry.name, value = text)
        f"(the ${entry.name} layer is rewritten: ${measured}/${entry.cap} characters. It is live from the next turn of every agent that sees it.)"
      }
    }
  }
}
